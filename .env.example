# --- SOMENTE NO SERVIDOR: descomente a linha abaixo ---
# Faz `docker compose` usar o arquivo de produção mesmo sem o `-f`. Sem isto,
# um `docker compose up` distraído sobe o compose de DEV, que faz bind-mount do
# repositório — e o container não acha `vendor/` (em produção ele vive dentro
# da imagem, não no disco).
# COMPOSE_FILE=docker-compose.prod.yml

APP_NAME=WeLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DEV: `db` é o container do docker-compose.yml.
# PRODUÇÃO: host/IP da máquina do Postgres — ele NÃO faz parte da stack.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=welog
DB_USERNAME=welog_user
DB_PASSWORD=secret_password
# Banco em outra máquina = tráfego na rede. `prefer` aceita conexão em claro se
# o servidor não oferecer TLS, sem avisar nada.
#
# Managed Database da DigitalOcean: a porta é 25060 (ou 25061, do pool) e o TLS
# é obrigatório — use no mínimo `require`. Para `verify-full` (que também
# protege contra man-in-the-middle), baixe o CA no painel da DO, salve em
# docker/backup/certs/ca-certificate.crt e aponte DB_SSLROOTCERT.
# Em produção, `welog:seguranca` acusa FALHA com `prefer` (docs/SEGURANCA.md).
DB_SSLMODE=prefer
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/certs/ca-certificate.crt

# Pool da DigitalOcean (porta 25061; DB_DATABASE = NOME DO POOL). Em modo
# Session, nada a mudar. Em modo Transaction, ligue isto — sem ele, erros
# "prepared statement does not exist" sob carga (docs/CAPACIDADE.md).
# DB_POOL_TRANSACTION=true

# Versão do Postgres do SERVIDOR — a imagem de backup precisa ser >= a ela,
# senão o pg_dump se recusa a rodar e o backup falha todo dia, em silêncio.
#
# Isto muda sem aviso: o Managed Database da DigitalOcean é atualizado por
# eles. Em 20/09/2026 o cluster já estava em 18.6 com a imagem em 16, e ficou
# sem nenhum backup até alguém olhar. Depois de qualquer upgrade do cluster:
# ajuste aqui, `build backup` e `up -d backup`.
#
# Confira com: SELECT version();
PG_VERSION=18

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (ver docs/EMAIL.md) ---
# DEV: Mailpit captura tudo, nada sai para a internet (http://localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@welog.local"
MAIL_FROM_NAME="${APP_NAME}"
# Fila dedicada dos e-mails (o worker já a consome). Vazio = 'mail'.
MAIL_QUEUE=mail

# Resend: transporte NATIVO, só a API key — sem host, porta ou usuário. É o que
# o painel do Resend entrega (a opção SMTP existe, mas reaproveita a mesma
# chave como senha e não acrescenta nada aqui).
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_...
# O remetente PRECISA ser de um domínio verificado na conta, senão o Resend
# recusa com 403 — é o erro mais comum e a mensagem não é óbvia.
RESEND_API_KEY=

# PRODUÇÃO — substitua o bloco acima por um provedor real e valide com
#   php artisan welog:mail:test voce@suaempresa.com
#
# SMTP autenticado (padrão; funciona com qualquer provedor):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.seuprovedor.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls          # 587 com STARTTLS; use 465 com MAIL_SCHEME=smtps
#   MAIL_USERNAME=
#   MAIL_PASSWORD=
#   MAIL_FROM_ADDRESS="no-reply@SEUDOMINIO.com.br"   # domínio com SPF/DKIM
#
# Amazon SES (as credenciais AWS_* são lidas por config/services.php):
#   MAIL_MAILER=ses
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_DEFAULT_REGION=sa-east-1
#
# Microsoft 365 SEM SMTP (API do Graph; passo a passo em docs/EMAIL.md):
#   MAIL_MAILER=microsoft-graph
#   MICROSOFT_GRAPH_TENANT_ID=     # ID do diretório (locatário)
#   MICROSOFT_GRAPH_CLIENT_ID=     # ID do aplicativo (cliente)
#   MICROSOFT_GRAPH_CLIENT_SECRET= # o VALOR do segredo, não o ID dele
#   MICROSOFT_GRAPH_SENDER=        # caixa que envia; vazio = MAIL_FROM_ADDRESS
#   MAIL_FROM_ADDRESS="atendimento@SEUDOMINIO.com.br"
#
# Resend (requer composer require resend/resend-php):
#   MAIL_MAILER=resend
#   RESEND_API_KEY=
#
# Failover entre DOIS provedores reais. Não deixe 'log' na cadeia em produção:
# o envio "teria sucesso" gravando em arquivo e a mensagem seria perdida.
#   MAIL_MAILER=failover
#   MAIL_FAILOVER_MAILERS=ses,smtp

# Contato de suporte mostrado ao Usuário (variável {{ contato }} dos modelos de
# e-mail e rodapé do portal) — por onde ele pede correção de endereço/dados.
# Ambos opcionais: sem nenhum, os e-mails dizem "responda este e-mail" e o
# portal esconde o bloco. WhatsApp com DDD (com ou sem +55); a máscara de
# exibição e o link wa.me são montados pelo sistema.
#   WELOG_SUPPORT_EMAIL=suporte@wegift.com.br
#   WELOG_SUPPORT_WHATSAPP=+55 11 99999-0000
WELOG_SUPPORT_EMAIL=
WELOG_SUPPORT_WHATSAPP=

VITE_APP_NAME="${APP_NAME}"

# --- Sentry (ver docs/OBSERVABILIDADE.md) ---
# Deixe VAZIO em dev e nos testes: sem DSN o SDK não inicializa e não consome
# sua cota. Preencha só no .env do servidor.
#
# ⚠️ Não ligue `send_default_pii` no config/sentry.php: esta aplicação trafega
# CPF, endereço e e-mail de clientes finais. O SentryScrubber filtra isso antes
# do envio, mas a opção anularia parte do cuidado.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
# Amostragem de performance. 0 = só erros (padrão). Suba com parcimônia: são
# cobradas como transações, e o volume aqui vem de jobs de integração.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# Sentry no navegador. É um DSN diferente (projeto "javascript" no Sentry) e
# fica embutido no bundle — DSN de browser é público por natureza.
# Chega na imagem por build arg; ver docker/php/Dockerfile.prod.
VITE_SENTRY_DSN=
# SENTRY_RELEASE e VITE_SENTRY_RELEASE são preenchidos pelo CI a cada deploy.

# --- Integrações (drivers: fake | api) — ver config/integrations.php ---
OMIE_DRIVER=fake
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Token que valida os webhooks recebidos da Omie (defina um valor forte e
# configure a mesma URL/token no painel da Omie)
OMIE_WEBHOOK_TOKEN=

# Intervalo mínimo entre duas chamadas do MESMO método da Omie, em ms.
# Não é o teto por minuto: é a rajada. Várias chamadas iguais no mesmo segundo
# viram 500 ("consumo redundante") e, insistindo, aplicativo suspenso.
# 0 desliga (só faz sentido em teste).
OMIE_MIN_INTERVAL_MS=2000

# ── Mais de um CNPJ na Omie ──────────────────────────────────────────────────
# Cada CNPJ é um aplicativo com chave própria: a chave de um NÃO enxerga o
# pedido do outro. Receber webhook dos dois é só registrar as duas URLs; para
# CONSULTAR, o sistema precisa saber de qual conta veio o evento — e quem diz
# isso é o token na URL.
#
# Liste as contas e dê a cada uma chave, segredo e token próprios. O nome é
# livre (vira prefixo em MAIÚSCULAS). Deixe VAZIO se houver um CNPJ só: aí
# valem as três variáveis acima e nada muda.
#
#   OMIE_ACCOUNTS=matriz,filial
#   OMIE_MATRIZ_APP_KEY=...
#   OMIE_MATRIZ_APP_SECRET=...
#   OMIE_MATRIZ_WEBHOOK_TOKEN=...            → URL: /webhooks/omie/<esse token>
#   OMIE_FILIAL_APP_KEY=...
#   OMIE_FILIAL_APP_SECRET=...
#   OMIE_FILIAL_WEBHOOK_TOKEN=...            → URL: /webhooks/omie/<esse token>
#
# Confira depois com: php artisan welog:omie:contas
OMIE_ACCOUNTS=

# Nome de exibição de cada conta — aparece no card "Conta Omie" do Projeto.
# Com várias contas: OMIE_<NOME>_LABEL (o <NOME> vem de OMIE_ACCOUNTS).
# Com conta única: OMIE_LABEL. Sem rótulo definido, o card fica oculto.
#   OMIE_WEBOX_LABEL="Webox"
#   OMIE_SANTA_LABEL="Santa Gestão"
#   OMIE_LABEL=

# Texto que marca um Pedido de Venda como Projeto WeLog, escrito no campo de
# observação do pedido na Omie (`observacoes.obs_venda`). A conta atende a
# operação inteira — 532 pedidos em 5 dias — e VAZIO significa SEM FILTRO:
# todo pedido vira Projeto. Aceita vários termos por vírgula; ignora caixa e
# acento. Ex.: OMIE_PROJECT_MARKER="projeto welog,kit onboarding wegift"
OMIE_PROJECT_MARKER=

# Projetos da Omie que viram Projeto WeLog, COM o template de card de cada um
# (o quadro do Trello lê o card pelo prefixo: [Evento], [COM Estoque]...).
# Formato: codigo=template, por vírgula. Templates: evento | com_estoque |
# amostra | sem_estoque | bosch_sem_estoque.
# Código mapeado aqui já é aceito: não precisa repetir em OMIE_PROJECT_CODES.
# Veja os códigos da conta com: php artisan welog:omie:projetos
#   OMIE_PROJECT_TEMPLATES="7828126392=evento,7828126432=com_estoque"
OMIE_PROJECT_TEMPLATES=

# PREFIRA ESTE ao marcador por texto: código(s) do cadastro de PROJETOS da
# Omie (`informacoes_adicionais.codProj` do pedido) que viram Projeto WeLog,
# por vírgula. Campo estruturado — não erra por acento nem por caixa. Rode
# `php artisan welog:omie:projetos` para ver os códigos da conta; o projeto
# "Venda" da Santa Origem é o 7407717220. Quando preenchido, o MARKER acima é
# ignorado. VAZIO = sem filtro por código.
OMIE_PROJECT_CODES=

# Varredura automática de pedidos novos (a rede por trás do webhook).
# DESLIGADA: ela cria Projeto para todo pedido dos últimos 2 dias que passe no
# filtro, enchendo a plataforma de pedido que ninguém pediu para acompanhar —
# e foi a rajada dela que suspendeu a conta da Omie. O caminho do pedido é o
# webhook; quando ele falhar, o resgate é manual:
#   php artisan welog:omie:sync-projects --dias=2 --dry-run
# true religa o agendamento de 15 em 15 minutos.
OMIE_RECONCILE_ORDERS=false

# Pedido de Venda do resgate (Importações Parceiros): valores da conta que o
# IncluirPedido exige. Os padrões vêm do pedido 65452 (resgate Suvinil feito à
# mão). OMIE_PEDIDO_PROJETO é o codProj Suvinil: mantém o pedido fora dos Projetos.
#   OMIE_PEDIDO_CATEGORIA=1.01.02
#   OMIE_PEDIDO_CONTA_CORRENTE=7310887094
#   OMIE_PEDIDO_CENARIO_IMPOSTOS=7310891385
#   OMIE_PEDIDO_PROJETO=7386090746
#   OMIE_PEDIDO_PARCELA=000

# Diretórios de entrada dos relatórios dos parceiros (Fluxo B), por vírgula
APPNOZ_INBOX_DIRS=appnoz-inbox
APPNOZ_SCAN_TIME=07:00

# Webhook da Suvinil (Importações Parceiros). O token vai NA URL e é a
# credencial inteira: https://SEU-DOMINIO/webhooks/suvinil/{token}
# Gere com: php artisan tinker --execute="echo bin2hex(random_bytes(24));"
# Vazio = webhook desligado, a rota recusa tudo.
SUVINIL_WEBHOOK_TOKEN=
SUVINIL_WEBHOOK_MAX_ROWS=200

# Webhook da Reconhece (cadastro de produto da vitrine da Suvinil).
# https://SEU-DOMINIO/webhooks/reconhece/{token}
# Vazio = webhook desligado, a rota recusa tudo.
RECONHECE_WEBHOOK_TOKEN=
RECONHECE_WEBHOOK_MAX_ROWS=500

# Publicação do catálogo na Reconhece. Endpoint e auth ainda não confirmados
# por eles; mantenha em `fake` até a documentação chegar.
RECONHECE_DRIVER=fake
RECONHECE_BASE_URL=
RECONHECE_API_KEY=

TRELLO_DRIVER=fake
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_API_SECRET=
TRELLO_BOARD_ID=
# Cards MODELO de cada tipo de campanha (codigo curto da URL do card no
# Trello: trello.com/c/<ESTE>/...). O card novo nasce copia do modelo:
# etiquetas/cor, checklists, campos personalizados, anexos e capa.
# Vazio = card criado do zero, com a etiqueta do tipo pintada pelo sistema.
#   TRELLO_CARD_TEMPLATES="evento=33wyYj44,com_estoque=Zmz776Yy"
TRELLO_CARD_TEMPLATES=

TRELLO_WEBHOOK_CALLBACK_URL=

# Flash — API de rastreio compatível Flash Courier (Bridge Link). Mesmos login,
# senha, clienteId e cttId da conta Flash. FLASH_KEY é opcional: vazio, é
# calculada (HMAC-SHA256 da senha com o login). Teste: php artisan welog:flash:testar
FLASH_DRIVER=fake
FLASH_BASE_URL=https://bridgelink.com.br
FLASH_LOGIN=
FLASH_SENHA=
FLASH_KEY=
FLASH_CLIENTE_ID=
# Um ou mais contratos, separados por vírgula: 7185,7200
FLASH_CTT_IDS=
# O que vai como número da encomenda (numEncCli) — tem de ser o formato
# parametrizado na Bridge Link. O combinado é o prefixo + nº da NF sem zeros
# (WEBOX44883): nf_number. Alternativas: nf_key (chave da NF) ou
# omie_order_number (nº do pedido).
FLASH_TRACKING_REFERENCE=nf_number
FLASH_TRACKING_PREFIX=WEBOX
# Importação de encomendas na Bridge Link (resgate com NF emitida → encomenda
# WEBOX + nº da NF). Usuário/senha vazios = os do rastreio. CCUSTO só se o
# contrato tiver mais de um centro de custo.
FLASH_IMPORT_ENABLED=true
FLASH_IMPORT_USUARIO=
FLASH_IMPORT_SENHA=
FLASH_IMPORT_CCUSTO_ID=
FLASH_IMPORT_REMETENTE=WeGift
# Campos do contrato que o exemplo de importação da Bridge Link manda em toda
# encomenda. Os valores são os da conta da WeGift (pedir ao suporte deles);
# vazio não vai. Exemplo da documentação: 21796, 157, CRS, 40013, 102.
FLASH_IMPORT_TIPO_ENC_ID=
FLASH_IMPORT_PROD_FLASH_ID=
FLASH_IMPORT_FRQ_REC_ID=
FLASH_IMPORT_ID_LOCAL_REM=
FLASH_IMPORT_NUM_CLIENTE=

# Homologação: `php artisan welog:nf:simular` fatura pedidos do Fluxo B com NF
# fictícia (sem emitir nota). NUNCA ligar em produção. Nota simulada só segue
# para a Flash com FLASH_DRIVER=fake.
WELOG_SIMULATED_INVOICES=false

CORREIOS_DRIVER=fake
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CONTRATO=
# Serviço da prepostagem: 03298 = PAC Contrato, 03220 = SEDEX Contrato.
# Varia por contrato — confirmar no painel CWS antes de ligar a prepostagem.
CORREIOS_CODIGO_SERVICO=03298

# --- Operação ---
# Fuso do negócio. O app ARMAZENA em UTC; este fuso formata as datas enviadas
# às APIs e os agendamentos (sem ele, entre 21h e 0h BRT a Omie é consultada
# com a data de "amanhã").
WELOG_BUSINESS_TIMEZONE=America/Sao_Paulo

# Precisa ser MAIOR que o --timeout do worker (120s), senão a fila reenfileira
# um job que ainda está executando e a mesma chamada de API acontece duas vezes.
REDIS_QUEUE_RETRY_AFTER=180

# Retenção (podadas por `model:prune`, agendado às 03:30).
# Eventos de webhook COM FALHA nunca são podados.
WELOG_RETENTION_WEBHOOK_EVENTS_DAYS=90
WELOG_RETENTION_TRACKING_EVENTS_DAYS=365

# Backup automático do Postgres (serviço `backup` do compose de produção).
# Confira com: php artisan welog:backup:status — ver docs/BACKUP.md
BACKUP_TIME=03:30
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8

# Cópia externa no Backblaze B2 (endpoint S3-compatível). SEM ISTO os backups
# ficam só no host do banco e não sobrevivem à perda do servidor.
# O endpoint aparece no painel do B2, em Buckets (varia por região).
# A retenção no B2 é feita por LIFECYCLE RULE do bucket — a chave abaixo NÃO
# precisa de permissão de apagar (ver docs/BACKUP.md).
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PREFIX=welog
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Produção: TLS via Let's Encrypt (docker/nginx/init-letsencrypt.sh) ---
# Domínio público do WeLog (registro A já apontado para o servidor) e e-mail de
# contato para o Let's Encrypt (avisos de expiração). Só usados em produção.
WELOG_DOMAIN=
LETSENCRYPT_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# CAPACIDADE — tamanho do pool do PHP e teto de login por origem.
# A conta de dimensionamento está em docs/CAPACIDADE.md; estes valores valem
# com `up -d app`, sem reconstruir a imagem.
# ─────────────────────────────────────────────────────────────────────────────
# `static` no dia da campanha: com `dynamic`, os primeiros segundos do pico são
# gastos criando processo enquanto as requisições se empilham.
PHP_FPM_MODE=dynamic
# (RAM da máquina - 1 GB) / 48 MB. Ver a tabela em docs/CAPACIDADE.md.
PHP_FPM_MAX_CHILDREN=12
PHP_FPM_START_SERVERS=4

# Tentativas de login/senha por minuto e por IP. A trava contra força bruta é
# a de 5 por minuto por CONTA, que não sai do código; esta existe contra a
# varredura que tenta mil e-mails diferentes. Precisa ser alta porque milhares
# de colaboradores da mesma empresa saem por um punhado de IPs.
PORTAL_AUTH_IP_LIMIT=600

# Trilha de auditoria (docs/SEGURANCA.md): retenção em dias (730 = 24 meses) e
# a partir de quantos dias sem login uma conta privilegiada vira "REVISAR" no
# welog:acessos:revisao.
WELOG_AUDIT_RETENTION_DAYS=730
WELOG_ACCESS_REVIEW_IDLE_DAYS=90
