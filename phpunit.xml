<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Integrações SEMPRE em `fake` na suíte, com force: sem isto o teste
            herda o driver do .env local e passa a chamar as APIs reais de
            produção (a Omie chega a bloquear a conta por "consumo indevido").
        -->
        <!-- Sem espaçamento entre chamadas: em teste a espera seria só tempo parado. -->
        <env name="OMIE_MIN_INTERVAL_MS" value="0" force="true"/>
        <env name="OMIE_DRIVER" value="fake" force="true"/>
        <env name="OMIE_PROJECT_CODES" value="" force="true"/>
        <env name="OMIE_PROJECT_MARKER" value="" force="true"/>
        <env name="OMIE_PROJECT_TEMPLATES" value="" force="true"/>
        <env name="TRELLO_DRIVER" value="fake" force="true"/>
        <env name="TRELLO_CARD_TEMPLATES" value="" force="true"/>
        <env name="FLASH_DRIVER" value="fake" force="true"/>
        <env name="CORREIOS_DRIVER" value="fake" force="true"/>
        <env name="CEP_DRIVER" value="fake" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
